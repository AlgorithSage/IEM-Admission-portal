PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/iem_admission_portal?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
UPLOAD_DIR=uploads

# PostgreSQL Configuration (or use Neon / Supabase DATABASE_URL on Vercel)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_postgres_password
PG_DATABASE=postgres
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
