PORT=5000
NODE_ENV=production

# Required in production
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/iem_admission_portal?retryWrites=true&w=majority
JWT_SECRET=<long random string>
JWT_EXPIRES_IN=7d
CORS_ORIGIN=

# PostgreSQL: DATABASE_URL (Neon / Supabase) or the PG_* settings below
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=postgres

# Document storage: set automatically by Vercel when a Blob store is connected to the project.
# Without it, files are stored on local disk (development only).
# BLOB_READ_WRITE_TOKEN=
UPLOAD_DIR=uploads

# Email (SMTP). Without SMTP_HOST, emails are recorded but not delivered.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_PASS=<16-character app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=IEM Admissions <your-address@example.com>

# Payment (test mode mock). Change the secret in production.
RAZORPAY_KEY_ID=rzp_test_mock_key
RAZORPAY_KEY_SECRET=<random string>
